{
  "name": "cmdb-backend",
  "version": "1.0.0",
  "description": "Backend API REST para Hiberus CMDB",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "seed": "tsx src/db/seed.ts",
    "backup": "node scripts/backup.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop cmdb-backend",
    "pm2:restart": "pm2 restart cmdb-backend",
    "pm2:logs": "pm2 logs cmdb-backend",
    "pm2:status": "pm2 status",
    "postbuild": "node -e \"const fs=require('fs');if(fs.existsSync('../frontend/dist')){fs.cpSync('../frontend/dist', './public', { recursive: true });console.log('Frontend assets copied to public/');}else{console.log('No frontend/dist found, skipping asset copy');}\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "pg": "^8.23.0",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.19",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
