PORT=5000
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=cmdb_hiberus
DEFAULT_EXPIRING_DAYS=30
LOG_LEVEL=info

# Notas:
# - PG_PASSWORD: debe coincidir con la contraseña del usuario PostgreSQL local.
#   Sin ella el backend falla al conectar.
# - JWT_SECRET: obligatorio. Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   Si se deja vacio, el login responde 500 (secretOrPrivateKey must have a value).