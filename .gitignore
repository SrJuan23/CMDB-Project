# ============================================================
# TTECH CMDB — .gitignore
# Objetivo: evitar commits de secretos, datos locales,
# artefactos de build y archivos sensibles de la empresa.
# ============================================================

# ---------------------------
# Node / dependencias
# ---------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/package-lock.json
yarn.lock
pnpm-lock.yaml

# ---------------------------
# Build / compilados
# ---------------------------
dist/
build/
*.tsbuildinfo

# ---------------------------
# Variables de entorno y secretos
# ---------------------------
.env
.env.*
.env.local
.env.*.local
!.env.example

# ---------------------------
# Base de datos local
# ---------------------------
*.sqlite
*.sqlite3
*.db
*.sqlite-shm
*.sqlite-wal
*.dump
data/cmdb.sqlite
backend/data/cmdb.sqlite

# ---------------------------
# Archivos subidos / adjuntos
# ---------------------------
uploads/
temp/
tmp/

# ---------------------------
# Sistema / IDE
# ---------------------------
.DS_Store
Thumbs.db
*.log
*.tmp
*.temp
.vscode/
.idea/
*.swp
*.swo

# ---------------------------
# Office / hojas de cálculo locales
# ---------------------------
*.xlsx
*.xls
*.csv
!data/CMDB_Soporte.xlsx

# ---------------------------
# Documentos sensibles
# ---------------------------
*.pdf
*.doc
*.docx

# ---------------------------
# Agentes / herramientas auxiliares
# ---------------------------
.kilo/
.kilocode/
.agent-manager.json
.agents/


